---
import { site } from '@/data/site'

const year = new Date().getFullYear()

const columns = [
  {
    title: 'Services',
    links: [
      { label: 'AC Repair', href: '/services/ac-repair/' },
      { label: 'AC Installation', href: '/services/ac-installation/' },
      { label: 'Furnace Repair', href: '/services/furnace-repair/' },
      { label: 'Furnace Installation', href: '/services/furnace-installation/' },
      { label: 'HVAC Maintenance', href: '/services/hvac-maintenance/' },
      { label: 'Emergency Repair', href: '/services/emergency-ac-repair/' },
      { label: 'Duct Cleaning & Sealing', href: '/services/air-duct-cleaning/' },
      { label: 'Commercial HVAC', href: '/services/commercial-hvac/' },
      { label: 'All services', href: '/services/' },
    ],
  },
  {
    title: 'Products',
    links: [
      { label: 'Air Conditioners', href: '/products/air-conditioners/' },
      { label: 'Heat Pumps', href: '/products/heat-pumps/' },
      { label: 'Gas Furnaces', href: '/products/gas-furnaces/' },
      { label: 'Ductless Mini-Splits', href: '/products/duct-free-systems/' },
      { label: 'Indoor Air Quality', href: '/products/indoor-air-quality/' },
      { label: 'Thermostats & Zoning', href: '/products/thermostats-zoning/' },
      { label: 'Full catalog', href: '/products/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Reviews', href: '/reviews/' },
      { label: 'Special Offers', href: '/special-offers/' },
      { label: 'Financing', href: '/financing/' },
      { label: 'Service Area', href: '/service-area/' },
      { label: 'Refer a Friend', href: '/refer-a-friend/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'DIY Troubleshooting', href: '/support/' },
      { label: 'Equipment Videos', href: '/videos/' },
      { label: 'Repair or Replace?', href: '/guides/repair-or-replace/' },
      { label: 'Select a New System', href: '/guides/select-new-system/' },
      { label: 'Energy Bill Concerns', href: '/guides/energy-bill-concerns/' },
      { label: 'Healthier Home', href: '/guides/healthier-home/' },
      { label: 'HVAC Glossary', href: '/glossary/' },
      { label: 'Blog', href: '/blog/' },
    ],
  },
]

const offices = [
  {
    name: 'Headquarters',
    street: site.address.street,
    city: `${site.address.city}, ${site.address.state} ${site.address.zip}`,
    phone: site.phoneDisplay,
    phoneHref: site.phoneHref,
  },
  ...site.branches.map((b) => ({
    name: b.name.replace('Big Texas Comfort of ', '') + ' branch',
    street: b.street,
    city: `${b.city}, ${b.state} ${b.zip}`,
    phone: b.phone,
    phoneHref: b.phoneHref,
  })),
]
---

<footer class="footer on-night">
  <div class="container-site">
    <!-- emergency call card -->
    <div class="foot-cta edge-lit">
      <div class="foot-cta-copy">
        <p class="type-label type-label--heat">24/7 emergency service</p>
        <p class="foot-cta-line type-h3">System down? We answer around the clock.</p>
        <p class="foot-cta-note">
          {site.hours.regular}, then the emergency line takes over. Free estimates and second opinions.
        </p>
      </div>
      <div class="foot-cta-actions">
        <a href={site.phoneHref} class="btn btn--primary btn--lg" data-magnetic="0.2">
          Call {site.phone}
        </a>
        <a href="/contact/" class="btn btn--ghost btn--lg">
          Request service <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- link columns -->
    <div class="foot-grid">
      <div class="foot-brand">
        <span class="foot-plate">
          <img src="/images/logo.png" alt="Big Texas Comfort" width="411" height="85" loading="lazy" class="foot-logo" />
        </span>
        <p class="foot-tag">“{site.tagline}”</p>
        <p class="foot-blurb">{site.description}</p>

        <ul class="foot-badges">
          <li>Independent American Standard® Dealer</li>
          <li>NATE-Certified Technicians</li>
          <li>Bonded &amp; Insured</li>
          <li>TX {site.license}</li>
        </ul>
      </div>

      {
        columns.map((col) => (
          <nav class="foot-col" aria-label={col.title}>
            <p class="type-label">{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <hr class="rule-fade" />

    <!-- offices -->
    <div class="foot-offices">
      {
        offices.map((o) => (
          <address class="foot-office">
            <p class="type-label">{o.name}</p>
            <p class="foot-office-addr">
              {o.street}
              <br />
              {o.city}
            </p>
            <a href={o.phoneHref} class="foot-office-phone">{o.phone}</a>
          </address>
        ))
      }
      <div class="foot-office foot-hours-block">
        <p class="type-label">Hours</p>
        <p class="foot-office-addr">
          {site.hours.regular}
          <br />
          {site.hours.emergency}
        </p>
      </div>
    </div>

    <hr class="rule-fade" />

    <!-- social + payment -->
    <div class="foot-strips">
      <div class="foot-strip">
        <p class="type-label">Follow</p>
        <ul class="foot-social">
          {
            site.social.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="foot-social-link">
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="foot-strip">
        <p class="type-label">Payment accepted</p>
        <ul class="foot-pay">
          {site.payments.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>

    <hr class="rule-fade" />

    <div class="foot-legal">
      <p>© {year} {site.name} All rights reserved.</p>
      <nav class="foot-legal-links" aria-label="Legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/service-area/">Service Area</a>
        <a href="/contact/">Contact</a>
      </nav>
      <p class="foot-trademark">
        Product logos and images are the property of their respective manufacturers.
      </p>
      <a href="#main" class="foot-top">
        Back to top <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 6vw, 5rem) 2.5rem;
  }

  /* ---- emergency card ---- */
  .foot-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem 2.5rem;
    padding: clamp(1.6rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-night-line);
    background:
      radial-gradient(34rem 22rem at 8% 120%, rgba(191, 31, 46, 0.24), transparent 70%),
      linear-gradient(160deg, #1b2239 0%, var(--color-night-soft) 100%);
    overflow: hidden;
  }
  .foot-cta-line {
    margin-top: 0.7rem;
    max-width: 22ch;
  }
  .foot-cta-note {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--color-night-ink-soft);
    max-width: 46ch;
  }
  .foot-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ---- link columns ---- */
  .foot-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) 2.5rem;
  }
  @media (min-width: 40rem) {
    .foot-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .foot-grid {
      grid-template-columns: 1.7fr repeat(4, 1fr);
      gap: 3rem 2rem;
    }
  }
  .foot-plate {
    display: inline-flex;
    background: #fdfdfb;
    border-radius: var(--radius-xs);
    padding: 0.45rem 0.7rem;
  }
  .foot-logo {
    display: block;
    width: auto;
    height: 2rem;
  }
  .foot-tag {
    margin-top: 0.8rem;
    color: var(--color-night-ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 560;
  }
  .foot-blurb {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-night-ink-soft);
    max-width: 38ch;
  }
  .foot-badges {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .foot-badges li {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-night-ink-soft);
    border: 1px solid var(--color-night-line);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.7rem;
  }

  .foot-col ul {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .foot-col a {
    font-size: 0.92rem;
    color: var(--color-night-ink-soft);
    text-decoration: none;
    transition: color 0.2s, padding-left 0.3s var(--ease-out-expo);
  }
  .foot-col a:hover {
    color: var(--color-night-ink);
    padding-left: 0.3rem;
  }

  /* ---- offices ---- */
  .foot-offices {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.25rem;
  }
  @media (min-width: 48rem) {
    .foot-offices {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .foot-office {
    font-style: normal;
  }
  .foot-office-addr {
    margin-top: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-night-ink-soft);
  }
  .foot-office-phone {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-night-ink);
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot-office-phone:hover {
    color: var(--color-heat-bright);
  }
  .foot-hours-block .foot-office-addr {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  /* ---- social + payment ---- */
  .foot-strips {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.25rem;
  }
  @media (min-width: 48rem) {
    .foot-strips {
      grid-template-columns: 1.3fr 1fr;
      gap: 3rem;
    }
  }
  .foot-social {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .foot-social-link {
    display: inline-flex;
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-night-ink);
    text-decoration: none;
    transition:
      border-color 0.25s var(--ease-swift),
      background-color 0.25s var(--ease-swift),
      transform 0.35s var(--ease-out-expo);
  }
  .foot-social-link:hover {
    border-color: var(--color-heat);
    background: color-mix(in srgb, var(--color-heat) 14%, transparent);
    transform: translateY(-2px);
  }
  .foot-pay {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .foot-pay li {
    font-size: 0.85rem;
    color: var(--color-night-ink-soft);
  }

  /* ---- legal ---- */
  .foot-legal {
    padding-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    font-size: 0.82rem;
    color: var(--color-night-ink-soft);
  }
  .foot-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .foot-legal-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .foot-legal-links a:hover {
    color: var(--color-night-ink);
  }
  .foot-trademark {
    flex-basis: 100%;
  }
  .foot-top {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    color: var(--color-night-ink);
    text-decoration: none;
    font-weight: 600;
    transition: border-color 0.25s, transform 0.35s var(--ease-out-expo);
  }
  .foot-top:hover {
    border-color: var(--color-night-ink-soft);
    transform: translateY(-2px);
  }
</style>
