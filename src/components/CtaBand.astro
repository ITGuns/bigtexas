---
import { site } from '@/data/site'

interface Props {
  title?: string
  note?: string
}
const { title = 'Ready when you are.', note = `Free estimates and second opinions · ${site.hours.regular} · ${site.hours.emergency}` } = Astro.props
---

<section class="ctaband on-night" aria-label="Contact call to action">
  <div class="container-site ctaband-inner">
    <div>
      <p class="type-label type-label--heat eyebrow" data-reveal="fade">{site.tagline}</p>
      <h2 class="type-h2 ctaband-title" data-reveal>{title}</h2>
      <p class="ctaband-note" data-reveal="fade" data-reveal-delay="0.1">{note}</p>
    </div>
    <div class="ctaband-actions" data-reveal data-reveal-delay="0.12">
      <a href={site.phoneHref} class="btn btn--primary btn--lg" data-magnetic="0.2">Call {site.phone}</a>
      <a href="/contact/" class="btn btn--ghost btn--lg">Request service <span class="btn-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .ctaband {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .ctaband-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 3rem;
  }
  .ctaband-title {
    margin-top: 1.2rem;
    max-width: 22ch;
  }
  .ctaband-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-night-ink-soft);
    max-width: 52ch;
  }
  .ctaband-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
</style>
