---
/**
 * Service agreements + maintenance rhythm. Copy grounded in the old site:
 * "Having your systems checked regularly keeps them running efficiently
 * and this saves you money on your utility bill month after month."
 */
const seasons = [
  { label: 'Spring', focus: 'Cooling tune-up', desc: 'Before the first heat wave hits', tone: 'cool' },
  { label: 'Summer', focus: 'Peak season', desc: 'System carries its heaviest load', tone: 'heat' },
  { label: 'Fall', focus: 'Heating check', desc: 'Ready before the first cold front', tone: 'cool' },
  { label: 'Winter', focus: 'Quiet months', desc: 'Efficiency holds, bills stay down', tone: 'heat' },
]
---

<section class="section care" aria-labelledby="care-title">
  <div class="container-site">
    <div class="care-head">
      <p class="type-label type-label--cool eyebrow" data-reveal="fade">Service agreements</p>
      <h2 class="type-h2" id="care-title" data-reveal>
        Maintenance isn’t a cost.<br />It’s where the savings come from.
      </h2>
      <p class="type-lede care-lede" data-reveal data-reveal-delay="0.1">
        Regular checks keep systems running efficiently. That saves you money on your utility
        bill month after month, cuts down on emergency calls, and extends equipment life.
      </p>
    </div>

    <ol class="care-seasons" data-reveal-group>
      {
        seasons.map((s) => (
          <li class:list={['care-season', `care-season--${s.tone}`]} data-reveal-child>
            <span class="type-label care-season-label">{s.label}</span>
            <h3 class="care-season-focus">{s.focus}</h3>
            <p class="care-season-desc">{s.desc}</p>
          </li>
        ))
      }
    </ol>

    <div class="care-cta" data-reveal>
      <div class="care-offer surface">
        <p class="care-offer-num">$89.50</p>
        <p class="care-offer-desc">Service call. The diagnostic includes the first hour of labor.</p>
      </div>
      <div class="care-actions">
        <a href="/services/service-agreements/" class="btn btn--night" data-magnetic="0.18">
          About service agreements <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/services/extended-warranties/" class="link-under care-link">Extended warranties on new equipment</a>
      </div>
    </div>
  </div>
</section>

<style>
  .care {
    background: var(--color-paper);
    border-block: 1px solid var(--color-line-soft);
  }
  .care-head h2 {
    margin-top: 1.4rem;
  }
  .care-lede {
    margin-top: 1.5rem;
    max-width: 44rem;
  }
  .care-seasons {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }
  @media (min-width: 64rem) {
    .care-seasons {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .care-season {
    position: relative;
    background: var(--grad-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.5rem 1.75rem;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out-expo),
      border-color 0.3s var(--ease-swift),
      box-shadow 0.45s var(--ease-out-expo);
  }
  /* temperature edge along the top of each card */
  .care-season::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    opacity: 0.9;
  }
  .care-season--cool::before {
    background: var(--grad-cool);
  }
  .care-season--heat::before {
    background: var(--grad-heat);
  }
  .care-season:hover {
    transform: translateY(-4px);
    border-color: var(--color-ink-faint);
    box-shadow: 0 18px 40px -26px rgba(22, 20, 26, 0.42);
  }
  /* the season label carries its own temperature colour */
  .care-season--cool .care-season-label {
    color: var(--color-cool);
  }
  .care-season--heat .care-season-label {
    color: var(--color-heat);
  }
  .care-season-focus {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .care-season-desc {
    margin-top: 0.4rem;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
  }

  .care-cta {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem 3rem;
  }
  .care-offer {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.5rem 1.9rem;
    border-radius: var(--radius-lg);
  }
  .care-offer-num {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 640;
    letter-spacing: -0.03em;
    color: var(--color-heat);
    line-height: 1;
  }
  .care-offer-desc {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    max-width: 24ch;
    line-height: 1.45;
  }
  .care-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .care-link {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }
</style>
