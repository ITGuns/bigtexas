---
import { site } from '@/data/site'

/**
 * One customer review exists on the old site, so this section earns its space
 * with context rather than volume: the verbatim quote, an honest rating line
 * that says what the score is based on, the real Angie's List award, and links
 * out to the platforms where more reviews actually live.
 */
const t = site.testimonial

/* Emphasise one clause without altering a character of the quote. */
const highlight = 'the price beat everyone'
const [before, after] = t.quote.split(highlight)

const platforms = [
  { name: 'Google', url: site.reviewLinks.google },
  { name: 'Yelp', url: site.reviewLinks.yelp },
  { name: 'Facebook', url: site.reviewLinks.facebook },
  { name: 'Angi', url: site.reviewLinks.angi },
]

const award = site.credentials.find((c) => c.id === 'angi-ssa')!
---

<section class="section on-night review" aria-labelledby="review-title">
  <div class="container-site">
    <div class="review-head">
      <p class="type-label type-label--heat" data-reveal="fade">From a customer</p>
      <h2 class="type-h2 review-title" id="review-title" data-reveal>
        What it sounds like<br class="hide-sm" /> when it goes right.
      </h2>
    </div>

    <div class="review-grid">
      <figure class="review-card" data-reveal>
        <span class="review-mark" aria-hidden="true">&ldquo;</span>

        <blockquote class="review-quote">
          <p>
            &ldquo;{before}<mark class="review-mark-text">{highlight}</mark>{after}&rdquo;
          </p>
        </blockquote>

        <figcaption class="review-by">
          <span class="review-stars" role="img" aria-label="Rated 5 out of 5">
            <span aria-hidden="true">★★★★★</span>
          </span>
          <span class="review-name">{t.author}</span>
          <span class="review-meta">{t.product} · {t.date}</span>
        </figcaption>
      </figure>

      <aside class="review-rail">
        <div class="review-score surface">
          <p class="review-score-num">5.0</p>
          <p class="review-score-note">
            The rating published on our own site, from the review above. More reviews live on the
            platforms where customers wrote them.
          </p>
        </div>

        <div class="review-award surface">
          <p class="type-label type-label--cool">Independently recognised</p>
          <p class="review-award-name">{award.name}</p>
          <p class="review-award-blurb">{award.blurb}</p>
        </div>

        <div class="review-links">
          <p class="type-label">Read or leave a review</p>
          <ul class="review-link-list">
            {
              platforms.map((p) => (
                <li>
                  <a href={p.url} target="_blank" rel="noopener" class="review-link">
                    <span>{p.name}</span>
                    <span class="review-link-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hide-sm {
    display: none;
  }
  @media (min-width: 48rem) {
    .hide-sm {
      display: inline;
    }
  }
  .review-title {
    margin-top: 1.3rem;
  }

  .review-grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 64rem) {
    .review-grid {
      grid-template-columns: 1.55fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }
  }

  /* ---- the quote ---- */
  .review-card {
    position: relative;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-night-line);
    background: linear-gradient(158deg, #1a2138 0%, var(--color-night-soft) 62%, #131829 100%);
    overflow: hidden;
  }
  .review-card::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: var(--grad-temperature);
    opacity: 0.7;
  }
  .review-mark {
    position: absolute;
    top: -1.5rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 16rem;
    line-height: 1;
    font-weight: 700;
    color: var(--color-heat);
    opacity: 0.09;
    pointer-events: none;
    user-select: none;
  }
  .review-quote p {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.9rem + 1.5vw, 2.05rem);
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.018em;
    max-width: 30ch;
    text-wrap: pretty;
  }
  /* the emphasised clause, still verbatim */
  .review-mark-text {
    background: none;
    color: var(--color-heat-bright);
  }

  .review-by {
    position: relative;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-night-line);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.35rem;
  }
  .review-stars {
    color: var(--color-heat-bright);
    letter-spacing: 0.18em;
    font-size: 0.95rem;
  }
  .review-name {
    font-weight: 660;
    font-size: 1.02rem;
  }
  .review-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-night-ink-soft);
  }

  /* ---- rail ---- */
  .review-rail {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .review-rail .surface {
    background: linear-gradient(160deg, #1a2138 0%, var(--color-night-soft) 100%);
    border-color: var(--color-night-line);
    padding: 1.5rem 1.6rem;
  }
  .review-score-num {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 3.4rem);
    font-weight: 660;
    letter-spacing: -0.035em;
    line-height: 1;
    background: var(--grad-heat);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .review-score-note {
    margin-top: 0.75rem;
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--color-night-ink-soft);
  }
  .review-award-name {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .review-award-blurb {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-night-ink-soft);
  }

  .review-links {
    padding-inline: 0.25rem;
  }
  .review-link-list {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .review-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    text-decoration: none;
    color: var(--color-night-ink);
    font-size: 0.9rem;
    font-weight: 600;
    transition:
      border-color 0.25s var(--ease-swift),
      background-color 0.25s var(--ease-swift),
      transform 0.35s var(--ease-out-expo);
  }
  .review-link:hover {
    border-color: var(--color-heat);
    background: color-mix(in srgb, var(--color-heat) 12%, transparent);
    transform: translateY(-2px);
  }
  .review-link-arrow {
    color: var(--color-night-ink-soft);
    font-size: 0.8rem;
  }
  .review-link:hover .review-link-arrow {
    color: var(--color-heat-bright);
  }
</style>
