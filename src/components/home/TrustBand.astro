---
const marks = [
  'Independent American Standard® Customer Care Dealer',
  'NATE-Certified Technicians',
  'Ductless Pro Contractor',
  'Bonded · Insured · Licensed TACLA28370C',
  '2017 Angie’s List Super Service Award',
  'Military & First Responders Friendly',
  'We Service All Makes & Models',
  'Free Estimates & Second Opinions',
]
---

<div class="trust marquee" role="region" aria-label="Credentials">
  <div class="marquee-track">
    {
      [0, 1].map((copy) => (
        <ul class="trust-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {marks.map((m) => (
            <li class="trust-item">
              <span class="trust-tick" aria-hidden="true">✳</span>
              {m}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .trust {
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    background: var(--color-paper);
    padding-block: 1.05rem;
  }
  .trust-list {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding-inline: 1.6rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .trust-tick {
    color: var(--color-heat);
    font-size: 0.85em;
  }
</style>
