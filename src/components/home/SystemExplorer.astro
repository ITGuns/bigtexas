---
import { serviceCategories, services } from '@/data/services'

/** SVG schematic parts lit per category */
const partMap: Record<string, string[]> = {
  cooling: ['condenser', 'lineset', 'airhandler'],
  heating: ['furnace', 'flue', 'airhandler'],
  'air-quality': ['air', 'vents', 'airhandler'],
  ductwork: ['ducts', 'vents', 'attic'],
  plans: ['shield', 'thermostat'],
  commercial: ['office'],
}
---

<section class="section explorer" id="system" aria-labelledby="explorer-title">
  <div class="container-site">
    <div class="explorer-head">
      <div>
        <p class="type-label type-label--cool eyebrow" data-reveal="fade">One crew, whole system</p>
        <h2 class="type-h2" id="explorer-title" data-reveal>
          Everything between the outdoor unit<br class="hide-sm" /> and the air you breathe.
        </h2>
      </div>
      <p class="type-lede explorer-lede" data-reveal data-reveal-delay="0.1">
        Licensed heating and air specialists with the tools, equipment and experience to keep the
        whole system running, not just the part that broke.
      </p>
    </div>

    <div class="explorer-body" data-explorer data-reveal="fade" data-reveal-delay="0.15">
      <!-- category rail -->
      <div class="explorer-rail" role="tablist" aria-label="Service categories">
        {
          serviceCategories.map((cat, i) => (
            <button
              class="rail-tab"
              role="tab"
              id={`tab-${cat.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${cat.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-cat={cat.id}
            >
              <span class="rail-tick" aria-hidden="true"></span>
              <span class="rail-name">{cat.name}</span>
            </button>
          ))
        }
      </div>

      <!-- schematic -->
      <div class="explorer-schematic" aria-hidden="true">
        <svg viewBox="0 0 560 420" fill="none" class="schematic-svg">
          <!-- ground -->
          <line x1="16" y1="392" x2="544" y2="392" class="sk-line" />
          <!-- house shell -->
          <path d="M96 392 V192 L236 96 L376 192 V392" class="sk-line sk-shell" />
          <!-- attic floor -->
          <line x1="96" y1="228" x2="376" y2="228" class="sk-line sk-dash" />

          <!-- ducts (attic runs + drops) -->
          <g data-part="ducts">
            <path d="M180 210 H344" class="sk-part" stroke-width="7" stroke-linecap="round" />
            <path d="M208 210 V246 M280 210 V246 M336 210 V246" class="sk-part" stroke-width="5" />
          </g>
          <!-- vents -->
          <g data-part="vents">
            <path d="M198 250 h20 M270 250 h20 M326 250 h20" class="sk-part" stroke-width="3" />
          </g>
          <!-- attic insulation -->
          <g data-part="attic">
            <path d="M110 224 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0 q8 -7 16 0" class="sk-part" stroke-width="2.5" />
          </g>

          <!-- air handler / furnace closet -->
          <g data-part="airhandler">
            <rect x="150" y="168" width="34" height="46" rx="4" class="sk-part" stroke-width="2.5" />
            <path d="M158 182 h18 M158 192 h18 M158 202 h18" class="sk-part" stroke-width="2" />
          </g>
          <!-- furnace flame -->
          <g data-part="furnace">
            <path d="M167 306 c-8 -10 -2 -20 5 -26 c-1 8 9 10 8 20 a11 11 0 0 1 -13 6 z" class="sk-part sk-fill" stroke-width="2" />
            <rect x="148" y="286" width="38" height="52" rx="5" class="sk-part" stroke-width="2.5" />
          </g>
          <!-- flue -->
          <g data-part="flue">
            <path d="M236 96 V56 M228 56 h16" class="sk-part" stroke-width="3" />
          </g>

          <!-- indoor air particles -->
          <g data-part="air">
            <circle cx="252" cy="300" r="3" class="sk-part sk-fill" />
            <circle cx="284" cy="284" r="2.4" class="sk-part sk-fill" />
            <circle cx="308" cy="312" r="2.8" class="sk-part sk-fill" />
            <circle cx="270" cy="330" r="2.2" class="sk-part sk-fill" />
            <circle cx="318" cy="342" r="2.6" class="sk-part sk-fill" />
            <circle cx="296" cy="356" r="2.2" class="sk-part sk-fill" />
          </g>

          <!-- thermostat -->
          <g data-part="thermostat">
            <rect x="330" y="292" width="18" height="26" rx="3" class="sk-part" stroke-width="2.5" />
            <circle cx="339" cy="302" r="4" class="sk-part" stroke-width="1.8" />
          </g>

          <!-- shield (plans) -->
          <g data-part="shield">
            <path d="M236 132 l22 8 v16 c0 14 -9 24 -22 30 c-13 -6 -22 -16 -22 -30 v-16 z" class="sk-part" stroke-width="2.5" />
            <path d="M226 158 l7 7 l14 -16" class="sk-part" stroke-width="2.5" />
          </g>

          <!-- condenser outside -->
          <g data-part="condenser">
            <rect x="420" y="330" width="62" height="62" rx="6" class="sk-part" stroke-width="2.5" />
            <circle cx="451" cy="361" r="19" class="sk-part" stroke-width="2.5" />
            <path d="M451 348 v26 M438 361 h26 M442 352 l18 18 M460 352 l-18 18" class="sk-part" stroke-width="1.6" />
          </g>
          <!-- line set -->
          <g data-part="lineset">
            <path d="M376 348 H420" class="sk-part sk-dash" stroke-width="3" />
          </g>

          <!-- office (commercial) -->
          <g data-part="office">
            <path d="M508 392 V240 h-64 v60" class="sk-part" stroke-width="2.5" />
            <path d="M456 258 h12 M476 258 h12 M456 278 h12 M476 278 h12 M476 300 h12 M476 322 h12 M476 344 h12" class="sk-part" stroke-width="2" />
          </g>
        </svg>
      </div>

      <!-- service panels -->
      <div class="explorer-panels">
        {
          serviceCategories.map((cat, i) => (
            <div
              class="explorer-panel"
              role="tabpanel"
              id={`panel-${cat.id}`}
              aria-labelledby={`tab-${cat.id}`}
              hidden={i !== 0}
            >
              <p class="panel-blurb">{cat.blurb}</p>
              <ul class="panel-list">
                {services
                  .filter((s) => s.category === cat.id)
                  .map((s) => (
                    <li>
                      <a href={`/services/${s.id}/`} class="panel-row">
                        <span class="panel-row-name">
                          {s.name}
                          {s.emergency && <span class="panel-badge">24/7</span>}
                        </span>
                        <span class="panel-row-short">{s.short}</span>
                        <span class="panel-row-arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .explorer-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .explorer-head h2 {
    margin-top: 1.4rem;
  }
  .explorer-lede {
    max-width: 30rem;
  }
  .hide-sm {
    display: none;
  }
  @media (min-width: 48rem) {
    .hide-sm {
      display: inline;
    }
  }

  .explorer-body {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 64rem) {
    .explorer-body {
      grid-template-columns: 15rem 1fr 24rem;
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* rail */
  .explorer-rail {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .explorer-rail::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 64rem) {
    .explorer-rail {
      flex-direction: column;
      overflow: visible;
      padding-bottom: 0;
    }
  }
  .rail-tab {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-size: 1.06rem;
    font-weight: 590;
    letter-spacing: -0.01em;
    color: var(--color-ink-faint);
    cursor: pointer;
    white-space: nowrap;
    text-align: left;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }
  .rail-tab:hover {
    color: var(--color-ink);
  }
  .rail-tab[aria-selected='true'] {
    color: var(--color-ink);
    background: var(--color-paper);
    border-color: var(--color-line);
  }
  .rail-tick {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-line);
    align-self: center;
    flex-shrink: 0;
    transition: background-color 0.25s, transform 0.3s var(--ease-out-expo);
  }
  .rail-tab[aria-selected='true'] .rail-tick {
    background: var(--color-heat);
    transform: scale(1.25);
  }

  /* schematic */
  .explorer-schematic {
    display: none;
  }
  @media (min-width: 48rem) {
    .explorer-schematic {
      display: block;
    }
  }
  .schematic-svg {
    width: 100%;
    height: auto;
  }
  .sk-line {
    stroke: var(--color-line);
    stroke-width: 2;
  }
  .sk-shell {
    stroke: var(--color-ink-faint);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .sk-dash {
    stroke-dasharray: 5 6;
  }
  .sk-part {
    stroke: var(--color-line);
    transition:
      stroke 0.4s var(--ease-swift),
      fill 0.4s var(--ease-swift),
      opacity 0.4s var(--ease-swift);
  }
  .sk-fill {
    fill: var(--color-line);
    stroke: none;
  }
  [data-part].is-active .sk-part {
    stroke: var(--color-heat);
  }
  [data-part].is-active .sk-fill {
    fill: var(--color-heat);
  }

  /* panels */
  .explorer-panel[hidden] {
    display: none;
  }
  .panel-blurb {
    font-size: 0.98rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .panel-list {
    display: flex;
    flex-direction: column;
  }
  .panel-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'name arrow'
      'short arrow';
    gap: 0.2rem 1rem;
    align-items: center;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--color-line-soft);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s, padding-left 0.3s var(--ease-out-expo);
  }
  .panel-row:hover {
    background: color-mix(in srgb, var(--color-paper) 70%, transparent);
    padding-left: 0.7rem;
  }
  .panel-row-name {
    grid-area: name;
    font-weight: 640;
    font-size: 1.02rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .panel-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-paper);
    background: var(--color-heat);
    border-radius: 4px;
    padding: 0.18rem 0.4rem;
  }
  .panel-row-short {
    grid-area: short;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    line-height: 1.45;
  }
  .panel-row-arrow {
    grid-area: arrow;
    color: var(--color-ink-faint);
    transition: transform 0.3s var(--ease-out-expo), color 0.2s;
  }
  .panel-row:hover .panel-row-arrow {
    transform: translateX(4px);
    color: var(--color-heat);
  }

  @media (prefers-reduced-motion: no-preference) {
    .explorer-panel:not([hidden]) .panel-list li {
      animation: panel-in 0.5s var(--ease-out-expo) backwards;
    }
    .explorer-panel:not([hidden]) .panel-list li:nth-child(2) { animation-delay: 0.05s; }
    .explorer-panel:not([hidden]) .panel-list li:nth-child(3) { animation-delay: 0.1s; }
    .explorer-panel:not([hidden]) .panel-list li:nth-child(4) { animation-delay: 0.15s; }
    .explorer-panel:not([hidden]) .panel-list li:nth-child(5) { animation-delay: 0.2s; }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script define:vars={{ partMap }}>
  const root = document.querySelector('[data-explorer]')
  if (root) {
    const tabs = [...root.querySelectorAll('[role="tab"]')]
    const panels = [...root.querySelectorAll('[role="tabpanel"]')]
    const parts = [...root.querySelectorAll('[data-part]')]

    function activate(tab, focus = true) {
      const cat = tab.dataset.cat
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
      }
      for (const p of panels) p.hidden = p.id !== `panel-${cat}`
      const active = partMap[cat] ?? []
      for (const part of parts) part.classList.toggle('is-active', active.includes(part.dataset.part))
      if (focus) tab.focus()
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab, false))
      tab.addEventListener('keydown', (e) => {
        let next = null
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length]
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length]
        if (e.key === 'Home') next = tabs[0]
        if (e.key === 'End') next = tabs[tabs.length - 1]
        if (next) {
          e.preventDefault()
          activate(next)
        }
      })
    })

    activate(tabs[0], false)
  }
</script>
