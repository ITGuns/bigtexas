---
/**
 * Proof wall — real photographs from the company's own gallery plus the
 * actual dealer and program badges. No stock photography anywhere.
 */
const tiles = [
  { type: 'photo', src: '/images/work-install-1.jpg', alt: 'Big Texas Comfort technician working on an outdoor condenser unit', w: 200, h: 200, caption: 'From the field' },
  { type: 'badge', src: '/images/badge-as-dealer.png', alt: 'American Standard Customer Care Dealer and Ductless Pro Contractor badges', w: 1200, h: 600, caption: 'Customer Care Dealer · Ductless Pro' },
  { type: 'photo', src: '/images/work-install-2.jpg', alt: 'Technician servicing an American Standard condenser at a Houston home', w: 200, h: 200, caption: 'Service call' },
  { type: 'badge', src: '/images/military-badges.png', alt: 'Military and First Responders friendly badges', w: 400, h: 412, caption: 'Military & First Responders friendly' },
  { type: 'photo', src: '/images/work-install-3.jpg', alt: 'Completed outdoor unit installation', w: 200, h: 200, caption: 'Install, set and sealed' },
  { type: 'badge', src: '/images/american-standard-logo.png', alt: 'American Standard Heating and Air Conditioning logo', w: 600, h: 315, caption: 'Independent dealer' },
]
---

<section class="workstrip" aria-label="Our work and credentials">
  <div class="container-site workstrip-head">
    <p class="type-label type-label--heat eyebrow" data-reveal="fade">Real crews, real installs</p>
    <p class="workstrip-note" data-reveal="fade" data-reveal-delay="0.08">
      Photos from our own jobs. See more on the&#32;<a href="/about/gallery/" class="link-under">gallery</a>&#32;and&#32;<a
        href="https://www.facebook.com/BigTexasComfort"
        target="_blank"
        rel="noopener"
        class="link-under">Facebook</a>.
    </p>
  </div>

  <div class="marquee workstrip-band" data-reveal="fade" data-reveal-delay="0.12">
    <div class="marquee-track workstrip-track">
      {
        [0, 1].map((copy) => (
          <div class="workstrip-set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {tiles.map((t) => (
              <figure class:list={['tile', `tile--${t.type}`]}>
                <div class="tile-frame">
                  <img src={t.src} alt={copy === 0 ? t.alt : ''} width={t.w} height={t.h} loading="lazy" />
                </div>
                <figcaption class="tile-caption type-label">{t.caption}</figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .workstrip {
    padding-block: var(--spacing-section);
    overflow: clip;
  }
  .workstrip-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .workstrip-note {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .workstrip-band:hover .marquee-track {
    animation-play-state: paused;
  }
  .workstrip-track {
    animation-duration: 55s;
  }
  .workstrip-set {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    padding-inline: 0.625rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex-shrink: 0;
  }
  .tile-frame {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-paper);
    display: grid;
    place-items: center;
    height: 13rem;
    transition: transform 0.4s var(--ease-out-expo), border-color 0.25s;
  }
  .tile:hover .tile-frame {
    transform: translateY(-4px);
    border-color: var(--color-ink-faint);
  }
  .tile--photo .tile-frame {
    width: 13rem;
    padding: 0;
  }
  .tile--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile--badge .tile-frame {
    width: 17rem;
    padding: 1.5rem;
  }
  .tile--badge img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .tile-caption {
    padding-left: 0.25rem;
  }
</style>
