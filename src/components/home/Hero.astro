---
import { site } from '@/data/site'
import { adVideos } from '@/data/videos'

/** The American Standard commercial runs muted and looping behind the headline. */
const film = adVideos.find((v) => v.id === 'raccoon-commercial')!
---

<section class="hero on-night" aria-label="Introduction">
  <div class="hero-visual" aria-hidden="true">
    <!-- poster paints instantly and stays put for reduced-motion visitors -->
    <img class="hero-poster" src={film.poster} alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
    <!--
      Self-hosted so it plays on every domain: the Vimeo original is
      embed-restricted to bigtexascomfort.com. Silent by design, since a
      background film is muted anyway.
    -->
    <div class="hero-film" data-hero-film data-src="/video/hero-promo.mp4"></div>
    <div class="hero-scrim"></div>
  </div>

  <div class="container-site hero-content">
    <div class="hero-copy">
      <p class="type-label hero-eyebrow" data-reveal="fade">
        Houston, TX · Independent American Standard® Dealer
      </p>
      <h1 class="type-display hero-title">
        <span class="hero-line"><span>Comfort,</span></span>
        <span class="hero-line"><span>engineered for</span></span>
        <span class="hero-line"><span>Texas heat<em>.</em></span></span>
      </h1>
      <p class="type-lede hero-lede" data-reveal data-reveal-delay="0.55">
        Heating, cooling and air quality, handled by factory-trained technicians who install,
        repair and maintain every major make and model. We call it “{site.tagline}” because
        that’s how long we plan to keep you.
      </p>
      <div class="hero-ctas" data-reveal data-reveal-delay="0.68">
        <a href="/contact/" class="btn btn--primary btn--lg" data-magnetic="0.22">
          Request Service <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href={site.phoneHref} class="btn btn--ghost btn--lg" data-magnetic="0.15">
          Call {site.phone}
        </a>
      </div>
    </div>

    <dl class="hero-stats" data-reveal-group>
      <div class="hero-stat" data-reveal-child>
        <dt class="type-label">Availability</dt>
        <dd>24/7 emergency · Mon to Sat, 7 AM to 9 PM</dd>
      </div>
      <div class="hero-stat" data-reveal-child>
        <dt class="type-label">Diagnostic</dt>
        <dd>$89.50 service call, first hour of labor included</dd>
      </div>
      <div class="hero-stat" data-reveal-child>
        <dt class="type-label">Estimates</dt>
        <dd>Free estimates &amp; second opinions</dd>
      </div>
      <div class="hero-stat" data-reveal-child>
        <dt class="type-label">Licensed</dt>
        <dd>TX {site.license} · Bonded &amp; insured</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: clip;
    isolation: isolate;
    background: var(--color-night);
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-poster,
  .hero-film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-poster {
    object-fit: cover;
    object-position: center 32%;
    filter: saturate(0.82) contrast(1.03);
  }
  .hero-film {
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.1s var(--ease-swift);
  }
  .hero-film.is-ready {
    opacity: 1;
  }
  /* The player letterboxes anything that is not 16:9, so the frame itself has
     to stay 16:9 and overflow the hero rather than being stretched to fit.
     Sized against the hero, not the viewport: the hero is taller than 100vh
     once the copy and stat plate are in it. */
  .hero-film :global(iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: auto;
    height: auto;
    min-width: 100%;
    min-height: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    pointer-events: none;
    filter: saturate(0.82) contrast(1.03);
  }
  /* the local fallback clip can simply cover, no letterbox to dodge */
  .hero-film :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.78) contrast(1.04);
  }

  /* readability scrim over the footage */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(46rem 30rem at 88% 24%, rgba(43, 76, 140, 0.28), transparent 70%),
      linear-gradient(
        100deg,
        rgba(13, 17, 32, 0.95) 0%,
        rgba(13, 17, 32, 0.86) 34%,
        rgba(13, 17, 32, 0.6) 62%,
        rgba(13, 17, 32, 0.5) 100%
      );
  }
  @media (max-width: 48rem) {
    .hero-scrim {
      background:
        radial-gradient(24rem 18rem at 60% 18%, rgba(43, 76, 140, 0.24), transparent 70%),
        linear-gradient(180deg, rgba(13, 17, 32, 0.82) 0%, rgba(13, 17, 32, 0.94) 70%);
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 7.5rem;
    padding-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vh, 4.5rem);
    flex: 1;
    justify-content: center;
  }

  .hero-copy {
    max-width: 44rem;
  }
  .hero-eyebrow {
    color: var(--color-night-ink-soft);
  }
  .hero-title {
    margin-top: 1.4rem;
    font-size: clamp(2.75rem, 1.2rem + 5.6vw, 6rem);
  }
  .hero-title em {
    font-style: normal;
    color: var(--color-heat-bright);
  }
  .hero-line {
    display: block;
    overflow: hidden;
  }
  .hero-line > span {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    html.js .hero-line > span {
      transform: translateY(110%);
      animation: hero-line-in 1.05s var(--ease-out-expo) forwards;
    }
    html.js .hero-line:nth-child(1) > span { animation-delay: 0.12s; }
    html.js .hero-line:nth-child(2) > span { animation-delay: 0.22s; }
    html.js .hero-line:nth-child(3) > span { animation-delay: 0.32s; }
  }
  @keyframes hero-line-in {
    to {
      transform: translateY(0);
    }
  }

  .hero-lede {
    margin-top: 1.6rem;
    max-width: 34rem;
  }
  .hero-ctas {
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--color-night-ink) 14%, transparent);
    background: color-mix(in srgb, #0d1120 72%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.1);
    backdrop-filter: blur(14px) saturate(1.1);
    overflow: hidden;
    box-shadow: 0 22px 60px -34px rgba(0, 0, 0, 0.9);
  }
  .hero-stats::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: var(--grad-temperature);
    opacity: 0.85;
  }
  @media (min-width: 64rem) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .hero-stat {
    position: relative;
    padding: 1.15rem 1.35rem 1.25rem;
  }
  .hero-stat + .hero-stat::before {
    content: '';
    position: absolute;
    inset-block: 0.9rem;
    inset-inline-start: 0;
    width: 1px;
    background: color-mix(in srgb, var(--color-night-ink) 16%, transparent);
  }
  @media (max-width: 63.99rem) {
    .hero-stat:nth-child(odd)::before {
      display: none;
    }
    .hero-stat:nth-child(n + 3)::after {
      content: '';
      position: absolute;
      inset-inline: 1rem;
      top: 0;
      height: 1px;
      background: color-mix(in srgb, var(--color-night-ink) 14%, transparent);
    }
  }
  .hero-stat dd {
    margin-top: 0.45rem;
    font-size: 0.94rem;
    color: var(--color-night-ink);
    line-height: 1.45;
    text-wrap: balance;
  }
</style>

<script>
  const holder = document.querySelector<HTMLElement>('[data-hero-film]')
  const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches
  // @ts-expect-error saveData is not in every lib.dom
  const saveData = navigator.connection?.saveData === true

  if (holder && motionOK && !saveData) {
    const start = () => {
      const video = document.createElement('video')
      video.src = holder.dataset.src ?? ''
      video.muted = true
      video.loop = true
      video.playsInline = true
      video.preload = 'auto'
      video.setAttribute('aria-hidden', 'true')
      video.addEventListener('loadeddata', () => holder.classList.add('is-ready'))
      holder.appendChild(video)
      void video.play().catch(() => {})

      // do not burn battery or bandwidth while the tab is in the background
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) video.pause()
        else void video.play().catch(() => {})
      })
    }
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 })
    else setTimeout(start, 300)
  }
</script>
