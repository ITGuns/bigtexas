---
import { site } from '@/data/site'

interface Props {
  /** 'night' when the nav sits over a dark hero, 'paper' over light pages */
  theme?: 'night' | 'paper'
}
const { theme = 'paper' } = Astro.props

const links = [
  { label: 'Services', href: '/services/' },
  { label: 'Products', href: '/products/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'Offers', href: '/special-offers/' },
  { label: 'Financing', href: '/financing/' },
  { label: 'About', href: '/about/' },
]
const path = Astro.url.pathname
---

<header class:list={['nav', `nav--${theme}`]} data-nav>
  <div class="container-site nav-inner">
    <a href="/" class="brand" aria-label="Big Texas Comfort home page">
      <span class="brand-plate">
        <img src="/images/logo.png" alt="Big Texas Comfort" width="411" height="85" class="brand-logo" />
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav-link', { 'nav-link--active': path.startsWith(l.href) }]}
            aria-current={path.startsWith(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-cta">
      <a href={site.phoneHref} class="nav-phone" aria-label={`Call ${site.phoneDisplay}`}>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3.7 1.5c.5-.5 1.3-.4 1.7.2l1.2 1.8c.3.5.3 1.1-.1 1.5l-.8.9a.5.5 0 0 0-.1.6 9.6 9.6 0 0 0 3.9 3.9c.2.1.5.1.6-.1l.9-.8c.4-.4 1-.4 1.5-.1l1.8 1.2c.6.4.7 1.2.2 1.7l-.9.9c-.6.6-1.5.9-2.3.6-2-.6-4-1.8-5.7-3.5S2.2 8.6 1.6 6.6c-.3-.8 0-1.7.6-2.3l.9-.9Z"
            fill="currentColor"></path>
        </svg>
        <span>{site.phone}</span>
      </a>
      <a href="/contact/" class="btn btn--primary btn--sm nav-btn" data-magnetic="0.18">Request Service</a>
      <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu-head container-site">
    <span class="type-label">Menu</span>
    <button class="mobile-close" aria-label="Close menu" data-menu-close>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav class="mobile-links container-site" aria-label="Mobile">
    <a href="/" class="mobile-link">Home</a>
    {links.map((l) => (
      <a href={l.href} class="mobile-link">{l.label}</a>
    ))}
    <a href="/support/" class="mobile-link">DIY Support</a>
    <a href="/contact/" class="mobile-link">Contact</a>
  </nav>
  <div class="mobile-foot container-site">
    <a href={site.phoneHref} class="btn btn--primary btn--lg mobile-call">Call {site.phone}</a>
    <p class="mobile-hours">{site.hours.regular} · {site.hours.emergency}</p>
  </div>
</div>

<style>
  /* The bar rides transparent at the top of the page, then lifts away from
     the edge into a floating capsule once you start scrolling. */
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 80;
    padding-top: 0;
    transition: padding-top 0.45s var(--ease-out-expo);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.5rem;
    padding-inline: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition:
      background-color 0.4s var(--ease-swift),
      border-color 0.4s var(--ease-swift),
      box-shadow 0.45s var(--ease-out-expo),
      padding 0.45s var(--ease-out-expo),
      height 0.45s var(--ease-out-expo);
  }

  /* theme: over dark hero */
  .nav--night {
    color: var(--color-night-ink);
  }
  /* theme: over light pages */
  .nav--paper {
    color: var(--color-ink);
  }

  .nav.nav--scrolled {
    padding-top: 0.75rem;
  }
  .nav--scrolled .nav-inner {
    height: 3.9rem;
    padding-inline: 1rem 0.85rem;
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    backdrop-filter: blur(18px) saturate(1.15);
    border-color: color-mix(in srgb, var(--color-ink) 10%, transparent);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 18px 44px -26px rgba(22, 20, 26, 0.5);
    color: var(--color-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav-inner {
      transition: none;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  /* the real logo is designed for a light ground — give it one everywhere */
  .brand-plate {
    display: inline-flex;
    align-items: center;
    background: #fdfdfb;
    border: 1px solid rgba(22, 20, 26, 0.08);
    border-radius: var(--radius-xs);
    padding: 0.35rem 0.6rem;
    transition: transform 0.3s var(--ease-out-expo);
  }
  .brand:hover .brand-plate {
    transform: scale(1.02);
  }
  .brand-logo {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }
  @media (min-width: 64rem) {
    .nav-links {
      display: flex;
    }
  }
  .nav-link {
    position: relative;
    font-size: 0.92rem;
    font-weight: 550;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    opacity: 0.85;
    transition:
      opacity 0.2s,
      background-color 0.28s var(--ease-swift),
      color 0.28s var(--ease-swift);
  }
  .nav-link:hover {
    opacity: 1;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .nav-link--active {
    opacity: 1;
    background: color-mix(in srgb, var(--color-heat) 13%, transparent);
    color: var(--color-heat);
  }
  .nav--night:not(.nav--scrolled) .nav-link--active {
    background: color-mix(in srgb, var(--color-heat-bright) 24%, transparent);
    color: var(--color-night-ink);
  }
  .nav-link:hover {
    opacity: 1;
  }
  .nav-link--active {
    opacity: 1;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .nav-phone {
    display: none;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: inherit;
    opacity: 0.9;
    transition: opacity 0.2s;
  }
  .nav-phone:hover {
    opacity: 1;
  }
  @media (min-width: 48rem) {
    .nav-phone {
      display: inline-flex;
    }
  }
  .nav-btn {
    display: none;
  }
  @media (min-width: 40rem) {
    .nav-btn {
      display: inline-flex;
    }
  }

  .nav-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.6rem;
    height: 2.6rem;
    align-items: center;
    background: color-mix(in srgb, currentColor 8%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: var(--radius-pill);
    cursor: pointer;
    color: inherit;
    transition: background-color 0.25s, transform 0.3s var(--ease-out-expo);
  }
  .nav-burger:hover {
    background: color-mix(in srgb, currentColor 16%, transparent);
    transform: scale(1.04);
  }
  .nav-burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-swift);
  }
  @media (min-width: 64rem) {
    .nav-burger {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: var(--color-night);
    color: var(--color-night-ink);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    flex-shrink: 0;
  }
  .mobile-close {
    background: none;
    border: 1px solid var(--color-night-line);
    border-radius: 999px;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    color: inherit;
    cursor: pointer;
  }
  .mobile-links {
    display: flex;
    flex-direction: column;
    padding-block: 1rem 2rem;
  }
  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 6.5vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-night-line);
    transition: color 0.2s;
  }
  .mobile-link:hover {
    color: var(--color-heat-bright);
  }
  .mobile-foot {
    margin-top: auto;
    padding-block: 1.5rem 2.5rem;
  }
  .mobile-call {
    width: 100%;
  }
  .mobile-hours {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--color-night-ink-soft);
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) {
      animation: menu-in 0.35s var(--ease-out-expo);
    }
    .mobile-menu:not([hidden]) .mobile-link {
      animation: link-in 0.5s var(--ease-out-expo) backwards;
    }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(1) { animation-delay: 0.05s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(2) { animation-delay: 0.09s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(3) { animation-delay: 0.13s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(4) { animation-delay: 0.17s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(5) { animation-delay: 0.21s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(6) { animation-delay: 0.25s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(7) { animation-delay: 0.29s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(8) { animation-delay: 0.33s; }
    .mobile-menu:not([hidden]) .mobile-link:nth-child(9) { animation-delay: 0.37s; }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes link-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
</style>

<script>
  const menu = document.getElementById('mobile-menu')
  const openBtn = document.querySelector('[data-menu-open]')
  const closeBtn = document.querySelector('[data-menu-close]')

  function setOpen(open: boolean) {
    if (!menu || !openBtn) return
    menu.hidden = !open
    openBtn.setAttribute('aria-expanded', String(open))
    document.documentElement.style.overflow = open ? 'hidden' : ''
    if (open) (menu.querySelector('a') as HTMLElement | null)?.focus()
    else (openBtn as HTMLElement).focus()
  }

  openBtn?.addEventListener('click', () => setOpen(true))
  closeBtn?.addEventListener('click', () => setOpen(false))
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false)
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setOpen(false)
  })
</script>
