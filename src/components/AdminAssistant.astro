---
/**
 * Admin assistant: answers questions about the live pipeline.
 *
 * Every figure is computed from the rows already rendered on the page, so it
 * cannot report a number the panel does not also show, and it needs no extra
 * database round trip.
 */
interface Props {
  /** compact snapshot of the pipeline, passed in from the page */
  snapshot: {
    leads: {
      id: number
      name: string
      city: string
      service: string
      status: string
      urgency: string
      created_at: string
      email: string
      phone: string
      follow_up_at: string | null
      review_sent_at: string | null
    }[]
    bookings: { id: number; name: string; service: string; date: string; status: string }[]
  }
}
const { snapshot } = Astro.props
---

<div class="aa" data-aa>
  <button class="aa-launcher" type="button" data-aa-open aria-expanded="false" aria-controls="aa-panel">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.8-5A8.2 8.2 0 0 1 3.6 11.5 8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4Z"
        stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    Ask about your data
  </button>

  <section class="aa-panel" id="aa-panel" data-aa-panel hidden aria-label="Pipeline assistant">
    <header class="aa-head">
      <p class="aa-title">Pipeline assistant</p>
      <button class="aa-close" type="button" data-aa-close aria-label="Close">
        <svg width="15" height="15" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div class="aa-log" data-aa-log role="log" aria-live="polite"></div>

    <div class="aa-chips">
      <button type="button" class="aa-chip" data-aa-chip>How many new leads?</button>
      <button type="button" class="aa-chip" data-aa-chip>Any emergencies?</button>
      <button type="button" class="aa-chip" data-aa-chip>What is booked this week?</button>
      <button type="button" class="aa-chip" data-aa-chip>Who needs a follow-up?</button>
      <button type="button" class="aa-chip" data-aa-chip>Who needs a review request?</button>
    </div>

    <form class="aa-form" data-aa-form>
      <input class="aa-input" type="text" placeholder="Ask about leads or bookings" autocomplete="off" data-aa-input aria-label="Question" />
      <button class="aa-send" type="submit" aria-label="Send">→</button>
    </form>
  </section>
</div>

<style>
  .aa {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
  }
  .aa-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    background: linear-gradient(160deg, #1c2440, #141a2b);
    color: var(--color-night-ink);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 620;
    cursor: pointer;
    box-shadow: 0 16px 40px -22px rgba(0, 0, 0, 0.9);
    transition: transform 0.3s var(--ease-out-expo), border-color 0.25s;
  }
  .aa-launcher:hover {
    transform: translateY(-2px);
    border-color: var(--color-cool-bright);
  }
  .aa.is-open .aa-launcher {
    display: none;
  }

  .aa-panel {
    width: min(22rem, calc(100vw - 2rem));
    height: min(28rem, calc(100vh - 6rem));
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-night-line);
    background: linear-gradient(168deg, #1a2138 0%, #0f1424 65%);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.9);
  }
  .aa-panel[hidden] {
    display: none;
  }
  .aa-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-night-line);
  }
  .aa-title {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: 0.95rem;
  }
  .aa-close {
    background: none;
    border: 1px solid var(--color-night-line);
    border-radius: var(--radius-pill);
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    color: inherit;
    cursor: pointer;
  }
  .aa-log {
    flex: 1;
    overflow-y: auto;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  /* built by the script below, so it never gets Astro's scoping attribute */
  .aa-log :global(.aa-msg) {
    max-width: 90%;
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .aa-log :global(.aa-msg--bot) {
    align-self: flex-start;
    background: color-mix(in srgb, var(--color-night-ink) 8%, transparent);
    border: 1px solid var(--color-night-line);
  }
  .aa-log :global(.aa-msg--user) {
    align-self: flex-end;
    background: color-mix(in srgb, var(--color-cool) 45%, transparent);
    color: #fff;
  }
  .aa-log :global(.aa-msg a) {
    color: var(--color-cool-bright);
  }
  .aa-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0 1rem 0.7rem;
  }
  .aa-chip {
    font-size: 0.74rem;
    padding: 0.32rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    background: none;
    color: var(--color-night-ink-soft);
    cursor: pointer;
  }
  .aa-chip:hover {
    border-color: var(--color-cool-bright);
    color: var(--color-night-ink);
  }
  .aa-form {
    display: flex;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--color-night-line);
  }
  .aa-input {
    flex: 1;
    font: inherit;
    font-size: 0.86rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-night-line);
    background: #0b0f1c;
    color: var(--color-night-ink);
  }
  .aa-send {
    width: 2.2rem;
    border-radius: var(--radius-pill);
    border: 0;
    background: var(--grad-cool);
    color: #fff;
    cursor: pointer;
    font-size: 1rem;
  }
</style>

<script define:vars={{ snapshot }}>
  const root = document.querySelector('[data-aa]')
  if (root) {
    const panel = root.querySelector('[data-aa-panel]')
    const log = root.querySelector('[data-aa-log]')
    const form = root.querySelector('[data-aa-form]')
    const input = root.querySelector('[data-aa-input]')
    const { leads, bookings } = snapshot
    let greeted = false

    const esc = (s) => { const d = document.createElement('div'); d.textContent = s ?? ''; return d.innerHTML }
    const say = (html) => {
      const el = document.createElement('div')
      el.className = 'aa-msg aa-msg--bot'
      el.innerHTML = html
      log.appendChild(el); log.scrollTop = log.scrollHeight
    }
    const you = (t) => {
      const el = document.createElement('div')
      el.className = 'aa-msg aa-msg--user'
      el.textContent = t
      log.appendChild(el); log.scrollTop = log.scrollHeight
    }
    const link = (l) => `<a href="/admin/leads/${l.id}/">${esc(l.name)}</a>`
    const list = (arr, fn) => arr.slice(0, 6).map(fn).join('<br>') + (arr.length > 6 ? `<br>…and ${arr.length - 6} more` : '')
    const days = (iso) => (Date.now() - new Date(iso).getTime()) / 864e5
    const today = new Date().toISOString().slice(0, 10)
    const inDays = (n) => new Date(Date.now() + n * 864e5).toISOString().slice(0, 10)
    /** 2026-08-24 reads as Mon, Aug 24, matching the tables on this page */
    const fmtDay = (d) => {
      const [y, m, day] = String(d).split('-').map(Number)
      if (!y || !m || !day) return String(d)
      return new Date(y, m - 1, day).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
    }

    function answer(q) {
      const s = q.toLowerCase()

      if (/emergenc|urgent/.test(s)) {
        const e = leads.filter((l) => l.urgency === 'emergency' && !['won', 'lost'].includes(l.status))
        return e.length
          ? `${e.length} open emergency ${e.length === 1 ? 'lead' : 'leads'}:<br>${list(e, (l) => `${link(l)} · ${esc(l.city || 'no city')} · ${esc(l.status)}`)}`
          : 'No open emergency leads right now.'
      }

      if (/follow.?up|chase|contact/.test(s)) {
        const f = leads.filter((l) => ['new', 'contacted'].includes(l.status) && l.email && !l.follow_up_at)
        return f.length
          ? `${f.length} ${f.length === 1 ? 'lead has' : 'leads have'} had no follow-up email:<br>${list(f, (l) => `${link(l)} · ${esc(l.email)}`)}`
          : 'Every open lead with an email address has been followed up.'
      }

      if (/review/.test(s)) {
        const r = leads.filter((l) => l.status === 'won' && l.email && !l.review_sent_at)
        return r.length
          ? `${r.length} finished ${r.length === 1 ? 'job has' : 'jobs have'} no review request:<br>${list(r, (l) => `${link(l)} · ${esc(l.email)}`)}`
          : 'No outstanding review requests.'
      }

      if (/book|appointment|schedul|this week|calendar/.test(s)) {
        const wk = inDays(7)
        const b = bookings.filter((x) => x.date && x.date >= today && x.date <= wk && x.status !== 'cancelled')
        return b.length
          ? `${b.length} ${b.length === 1 ? 'booking' : 'bookings'} in the next 7 days:<br>${list(b, (x) => `${esc(fmtDay(x.date))} · ${esc(x.name || 'unlinked')} · ${esc(x.service || 'service visit')} · ${esc(x.status)}`)}`
          : 'Nothing booked in the next 7 days.'
      }

      if (/stale|old|waiting|sat|ignored/.test(s)) {
        const st = leads.filter((l) => l.status === 'new' && days(l.created_at) > 1)
        return st.length
          ? `${st.length} ${st.length === 1 ? 'lead has' : 'leads have'} been in New over a day:<br>${list(st, (l) => `${link(l)} · ${Math.floor(days(l.created_at))}d`)}`
          : 'Nothing has been sitting in New for more than a day.'
      }

      if (/new lead|how many lead|lead count|total lead/.test(s) || /^how many/.test(s)) {
        const counts = {}
        for (const l of leads) counts[l.status] = (counts[l.status] || 0) + 1
        const parts = Object.entries(counts).map(([k, v]) => `${v} ${k}`).join(', ')
        return leads.length ? `${leads.length} leads in total: ${parts}.` : 'No leads yet.'
      }

      if (/won|closed|revenue|sold/.test(s)) {
        const w = leads.filter((l) => l.status === 'won')
        return w.length ? `${w.length} ${w.length === 1 ? 'job' : 'jobs'} marked won.` : 'No jobs marked won yet.'
      }

      if (/city|area|where/.test(s)) {
        const byCity = {}
        for (const l of leads) if (l.city) byCity[l.city] = (byCity[l.city] || 0) + 1
        const top = Object.entries(byCity).sort((a, b) => b[1] - a[1])
        return top.length
          ? `Leads by city:<br>${top.slice(0, 8).map(([c, n]) => `${esc(c)}: ${n}`).join('<br>')}`
          : 'No city recorded on any lead yet.'
      }

      // name or phone lookup
      const card = (l) =>
        `${link(l)} · ${esc(l.status)} · ${esc(l.service || 'no service set')} · ${esc(l.city || 'no city')}<br>${esc(l.phone || '')} ${esc(l.email || '')}`
      let hit = leads.find((l) => s.includes(l.name.toLowerCase()) || (l.phone && s.includes(l.phone.replace(/\D/g, ''))))
      if (!hit) {
        // the owner types "Dana", not "Dana Whitfield". Match a whole first or
        // last name; anything shorter than three letters is too loose.
        const words = new Set(s.replace(/[^a-z0-9 ]/g, ' ').split(/\s+/).filter((w) => w.length >= 3))
        const partial = leads.filter((l) =>
          l.name.toLowerCase().split(/\s+/).some((w) => w.length >= 3 && words.has(w)),
        )
        if (partial.length === 1) hit = partial[0]
        else if (partial.length > 1) {
          return `${partial.length} leads match that name:<br>${list(partial, (l) => `${link(l)} · ${esc(l.city || 'no city')} · ${esc(l.status)}`)}`
        }
      }
      if (hit) return card(hit)

      return 'I can answer on leads by status, emergencies, stale leads, follow-ups, review requests, bookings this week, and leads by city. You can also type a customer name.'
    }

    function ask(q) {
      you(q)
      say(answer(q))
    }

    const setOpen = (open) => {
      panel.hidden = !open
      root.classList.toggle('is-open', open)
      root.querySelector('[data-aa-open]').setAttribute('aria-expanded', String(open))
      if (open) {
        if (!greeted) {
          say(`Ask me about the pipeline. I read the ${leads.length} lead${leads.length === 1 ? '' : 's'} and ${bookings.length} booking${bookings.length === 1 ? '' : 's'} on this page.`)
          greeted = true
        }
        input.focus()
      }
    }

    root.querySelector('[data-aa-open]').addEventListener('click', () => setOpen(true))
    root.querySelector('[data-aa-close]').addEventListener('click', () => setOpen(false))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) setOpen(false) })
    for (const c of root.querySelectorAll('[data-aa-chip]')) c.addEventListener('click', () => ask(c.textContent.trim()))
    form.addEventListener('submit', (e) => {
      e.preventDefault()
      const v = input.value.trim()
      if (!v) return
      input.value = ''
      ask(v)
    })
  }
</script>
