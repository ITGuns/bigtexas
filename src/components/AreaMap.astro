---
import { cities } from '@/data/cities'

interface Props {
  /** highlight one city on the map */
  active?: string
}
const { active } = Astro.props
---

<div class="area-map" data-reveal="scale" aria-hidden="true">
  <svg viewBox="0 0 100 100" class="area-map-svg">
    <path
      d="M74 2 C70 12 76 18 70 26 C64 34 70 40 66 48 C62 56 68 60 64 68 C60 76 66 82 62 92 L60 100 L100 100 L100 0 L76 0 Z"
      class="map-water"></path>
    <path
      d="M74 2 C70 12 76 18 70 26 C64 34 70 40 66 48 C62 56 68 60 64 68 C60 76 66 82 62 92"
      class="map-shore"
      fill="none"></path>
    {
      cities.map((c) => {
        const isHq = c.id === 'clear-lake-city'
        const isActive = active === c.id
        return (
          <g class:list={['map-city', { 'map-city--active': isActive }]}>
            <circle
              cx={c.map.x}
              cy={c.map.y}
              r={isActive ? 2 : 1.4}
              class:list={['map-dot', { 'map-dot--hq': isHq, 'map-dot--active': isActive }]}
            />
            {(isHq || isActive) && <circle cx={c.map.x} cy={c.map.y} r="3.2" class="map-ring" />}
            <text
              x={c.map.x + 2.6}
              y={c.map.y + 1}
              class:list={['map-label', { 'map-label--active': isActive }]}
            >
              {c.name}
            </text>
          </g>
        )
      })
    }
  </svg>
</div>

<style>
  .area-map {
    background: var(--color-night);
    border-radius: var(--radius-md);
    padding: clamp(1rem, 3vw, 2rem);
    aspect-ratio: 1;
    width: 100%;
  }
  .area-map-svg {
    width: 100%;
    height: 100%;
  }
  .map-water {
    fill: color-mix(in srgb, var(--color-cool) 24%, var(--color-night));
  }
  .map-shore {
    stroke: var(--color-cool-bright);
    stroke-width: 0.35;
    stroke-opacity: 0.6;
  }
  .map-dot {
    fill: var(--color-bone);
  }
  .map-dot--hq {
    fill: var(--color-heat-bright);
  }
  .map-dot--active {
    fill: var(--color-heat-bright);
  }
  .map-ring {
    fill: none;
    stroke: var(--color-heat-bright);
    stroke-width: 0.3;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: no-preference) {
    .map-ring {
      animation: map-pulse 2.6s ease-out infinite;
      transform-origin: center;
      transform-box: fill-box;
    }
  }
  @keyframes map-pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  .map-label {
    fill: var(--color-night-ink-soft);
    font-family: var(--font-mono);
    font-size: 2.4px;
    letter-spacing: 0.08em;
  }
  .map-label--active {
    fill: var(--color-night-ink);
    font-weight: 600;
  }
</style>
