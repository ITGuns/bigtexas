---
import Base from '@/layouts/Base.astro'
import PageHero from '@/components/PageHero.astro'
import CtaBand from '@/components/CtaBand.astro'
import { productPage } from '@/data/extracted'
import { getProductImage } from '@/data/productImages'
import { site } from '@/data/site'

/** Group blurbs are written per section: the scraped hub pages all open with
 *  the same SEET paragraph, which reads as duplication when stacked. */
const groups = [
  {
    id: 'cooling',
    name: 'Cooling',
    blurb:
      'Central air conditioners, heat pumps and ductless systems, from the local efficiency minimum up to 24 SEER2. Every American Standard design is tested at the SEET facility under the worst conditions the lab can produce.',
    items: ['air-conditioners', 'heat-pumps', 'duct-free-systems', 'evaporator-coils', 'packaged-units'],
  },
  {
    id: 'heating',
    name: 'Heating',
    blurb:
      'Gas furnaces from 80% AFUE up past 97%, hybrid heat pairings that switch to whichever fuel runs cheaper, and the air handlers that move it all through the house.',
    items: ['gas-furnaces', 'hybrid-heat', 'air-handlers'],
  },
  {
    id: 'air-quality',
    name: 'Indoor Air Quality',
    blurb:
      'Your home should be your safe place. We carry filtration, humidity control, ventilation and monitoring equipment that targets indoor air pollutants rather than masking them.',
    items: [
      'indoor-air-quality',
      'air-cleaners',
      'micropure-with-duo-field-control',
      'dehumidifiers',
      'humidifiers',
      'ventilators',
      'ultra-violet-lights',
      'carbon-monoxide-detectors',
    ],
  },
  {
    id: 'controls',
    name: 'Thermostats, Zoning & Controls',
    blurb:
      'Thermostats are the brain of the system and zoning is the muscle. Together they put the right amount of conditioned air in the rooms that actually need it.',
    items: ['thermostats', 'thermostats-zoning', 'zoning', 'american-standard-home-app'],
  },
].map((g) => ({
  ...g,
  pages: g.items.map((slug) => productPage(slug)).filter((p) => !!p),
}))
---

<Base
  title="HVAC Products from an American Standard Dealer in Houston, TX | Big Texas Comfort"
  description="American Standard air conditioners, heat pumps, gas furnaces, ductless systems, indoor air quality equipment, thermostats and zoning from an independent Customer Care Dealer in Houston, TX."
>
  <PageHero
    eyebrow="American Standard® dealer"
    tone="cool"
    lede="As an independent American Standard dealer we carry a complete line of indoor comfort equipment, with innovations that raise the standards of comfort and reliability. We'll help you customize a solution that's right for you."
    crumbs={[{ label: 'Products' }]}
  >
    Equipment catalog
  </PageHero>

  <section class="prods">
    <div class="container-site">
      {
        groups.map((g) => (
          <div class="prods-group" id={g.id}>
            <div class="prods-group-head" data-reveal>
              <h2 class="type-h3">{g.name}</h2>
              <p class="prods-group-blurb">{g.blurb}</p>
            </div>
            <ul class="prods-grid" data-reveal-group>
              {g.pages.map((p) => (
                <li data-reveal-child>
                  <a href={`/products/${p!.slug}/`} class="prods-card surface card-hover">
                    {getProductImage(p!.slug) && (
                      <span class="prods-card-shot">
                        <img
                          src={getProductImage(p!.slug)!.src}
                          alt=""
                          width="120"
                          height="120"
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                    )}
                    <span class="prods-card-name">{p!.h1 ?? p!.slug}</span>
                    <span class="prods-card-sum">{p!.summary}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <p class="prods-note" data-reveal>
        <strong>We service all brands.</strong> The catalog above is what we install new. Repair
        and maintenance cover every make and model. Questions? Call {site.phoneDisplay}.
      </p>
    </div>
  </section>

  <CtaBand title="Sizing, efficiency, budget: we’ll match the system to the house." />
</Base>

<style>
  .prods {
    padding-bottom: var(--spacing-section);
  }
  .prods-group {
    padding-block: 2.5rem;
    border-top: 1px solid var(--color-line);
  }
  .prods-group-head {
    margin-bottom: 1.75rem;
    max-width: 60rem;
  }
  .prods-group-blurb {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }
  .prods-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .prods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .prods-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .prods-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    padding: 1.4rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  .prods-card-shot {
    display: grid;
    place-items: center;
    height: 6.75rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(160deg, #ffffff, #f2efe7);
    border: 1px solid var(--color-line-soft);
    overflow: hidden;
    margin-bottom: 0.3rem;
  }
  .prods-card-shot img {
    max-width: 62%;
    max-height: 78%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 0.5s var(--ease-out-expo);
  }
  .prods-card:hover .prods-card-shot img {
    transform: scale(1.08) translateY(-2px);
  }
  .prods-card-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }
  .prods-card-sum {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .prods-card-count {
    color: var(--color-cool);
  }
  .prods-note {
    margin-top: 3rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-cool);
    background: var(--color-paper);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    max-width: 56rem;
  }
</style>
