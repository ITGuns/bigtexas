---
import '@fontsource-variable/bricolage-grotesque'
import '@fontsource-variable/instrument-sans'
import '@fontsource-variable/jetbrains-mono'
import '@/styles/global.css'
import '@/styles/admin.css'
import { storageReady, listChats } from '@/lib/db'

interface Props {
  title: string
  active?: 'dashboard' | 'leads' | 'bookings' | 'chats'
}
const { title, active } = Astro.props

/**
 * Conversations waiting on a person are the one thing in here that goes stale
 * in minutes, so the count rides in the nav on every admin page.
 */
let waiting = 0
try {
  const chats = await listChats()
  waiting = chats.filter((c) => c.status === 'waiting' || c.agent_unread > 0).length
} catch {
  waiting = 0
}

const nav = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin/', badge: 0 },
  { id: 'leads', label: 'Leads', href: '/admin/leads/', badge: 0 },
  { id: 'bookings', label: 'Bookings', href: '/admin/bookings/', badge: 0 },
  { id: 'chats', label: 'Chats', href: '/admin/chats/', badge: waiting },
]
---

<!doctype html>
<html lang="en" class="admin-root">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Big Texas Comfort Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin-body">
    <header class="admin-bar edge-lit">
      <div class="admin-bar-inner">
        <a href="/admin/" class="admin-brand">
          <span class="admin-logo-plate">
            <img src="/images/logo.png" alt="Big Texas Comfort" width="411" height="85" />
          </span>
          <span class="admin-brand-tag">Control Panel</span>
        </a>

        <nav class="admin-nav" aria-label="Admin sections">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={['admin-nav-link', { 'is-active': active === n.id }]}
                aria-current={active === n.id ? 'page' : undefined}
              >
                {n.label}
                {n.badge > 0 && <span class="admin-nav-badge">{n.badge}</span>}
              </a>
            ))
          }
        </nav>

        <div class="admin-bar-actions">
          <a href="/" class="admin-view-site" target="_blank" rel="noopener">View site</a>
          <form method="POST" action="/admin/logout/">
            <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
          </form>
        </div>
      </div>
    </header>

    {
      !storageReady && (
        <p class="admin-warn">
          Storage is not configured. Set <code>SUPABASE_URL</code> and <code>SUPABASE_SERVICE_ROLE_KEY</code>,
          then redeploy. Until then the website cannot accept new requests.
        </p>
      )
    }


    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>
