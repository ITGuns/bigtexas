# Copy to .env for local work, and set the same keys in the Vercel project.
# .env is gitignored. Never commit real values.

# ---- Admin panel (required) ----
# The single shared password for /admin.
ADMIN_PASSWORD=change-me
# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me

# ---- Supabase (required in production) ----
# Dashboard > Project Settings > Data API.
# Without these the app falls back to a local SQLite file at data/bigtexas.db,
# which is what `npm run dev` and the test suite use.
SUPABASE_URL=https://your-project.supabase.co
# Service role key: bypasses row level security, so it is server-only.
# Never expose it to the browser and never prefix it with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Optional ----
# Canonical origin used for sitemap and og: URLs.
SITE_URL=https://www.bigtexascomfort.com
# Override the local SQLite path.
# BTC_DB_PATH=./data/bigtexas.db
